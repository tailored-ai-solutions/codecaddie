// Project-level configuration for the CodeCaddie Xcode bridge.
//
// The Apple team ID never appears in a tracked file. On Xcode Cloud,
// xcode/ci_scripts/ci_post_clone.sh writes XcodeCloud.local.xcconfig from the
// CODECADDIE_APPLE_TEAM_ID custom environment variable of the workflow; the
// project's DEVELOPMENT_TEAM and scripts/assemble-macos-xcode.sh both read
// CODECADDIE_APPLE_TEAM_ID from it. The include is optional, so local builds
// without the file stay unsigned developer builds.
#include? "XcodeCloud.local.xcconfig"
