{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codecaddie.ai/protocol/core.schema.json",
  "title": "CodeCaddie core protocol",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" },
    { "$ref": "#/$defs/event" }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "required": ["id", "protocolVersion", "method", "params"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "protocolVersion": { "const": 2 },
        "workspaceId": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "params": { "type": "object" }
      },
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "required": ["id", "ok"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "ok": { "type": "boolean" },
        "result": {},
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string" },
            "message": { "type": "string" },
            "retryable": { "type": "boolean" },
            "details": {}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": ["sequence", "topic", "payload"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 0 },
        "workspaceId": { "type": "string", "minLength": 1 },
        "topic": { "type": "string", "minLength": 1 },
        "payload": {}
      },
      "additionalProperties": false
    }
  }
}
