{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codecaddie.ai/protocol/repository-assurance-index-v1.schema.json",
  "title": "CodeCaddie repository assurance index v1",
  "description": "Optional routing metadata. Referenced artifacts must still be inspected and cited; this index is never implementation evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "controls"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "controls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/control" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9._-]+$"
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "topics", "artifacts"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "topics": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
          }
        }
      }
    }
  }
}
